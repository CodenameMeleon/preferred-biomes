accessWidener v2 official

# The constructor is private; the two static factories only accept one side of the Either each,
# and a subclass needs to pass the Either straight through.
accessible	method	net/minecraft/world/level/biome/MultiNoiseBiomeSource	<init>	(Lcom/mojang/datafixers/util/Either;)V

# The "preset" half of vanilla's codec pair. DIRECT_CODEC (the "biomes" half) is already public,
# so only this one needs widening. NOT ENTRY_CODEC: that is Biome.CODEC.fieldOf("biome"),
# a single biome used as the element codec inside Climate.ParameterList.codec, and pairing it with
# PRESET_CODEC would expect a lone "biome" field where vanilla writes a "biomes" list.
accessible	field	net/minecraft/world/level/biome/MultiNoiseBiomeSource	PRESET_CODEC	Lcom/mojang/serialization/MapCodec;

# SurfaceRules.Context is a protected nested class and SurfaceRules.Condition is package-private,
# so a ConditionSource written outside net.minecraft.world.level.levelgen cannot name either —
# and ConditionSource is Function<Context, Condition>, so implementing it requires naming both.
# These two lines make the TYPES nameable and nothing more; the context's fields stay
# package-private and are reached through MaterialRuleContextAccessor instead.
accessible	class	net/minecraft/world/level/levelgen/SurfaceRules$Context
accessible	class	net/minecraft/world/level/levelgen/SurfaceRules$Condition

# Biome.ClimateSettings is a package-private record and Biome.climateSettings is private, so a
# downfall value cannot be read from outside net.minecraft.world.level.biome - there is no
# getDownfall() in 1.20.1, only getBaseTemperature(). This line makes the TYPE nameable and nothing
# more, exactly as the two SurfaceRules lines above do; the field itself is reached through
# BiomeWeatherAccessor.
accessible	class	net/minecraft/world/level/biome/Biome$ClimateSettings
