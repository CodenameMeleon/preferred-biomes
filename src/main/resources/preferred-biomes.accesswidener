# The "preset" half of vanilla's codec pair. CUSTOM_CODEC (the "biomes" half) is already public,
# so only this one needs widening. NOT BIOME_CODEC: that is Biome.REGISTRY_CODEC.fieldOf("biome"),
# a single biome used as the element codec inside Entries.createCodec, and pairing it with
# PRESET_CODEC would expect a lone "biome" field where vanilla writes a "biomes" list.
accessible	field	net/minecraft/world/biome/source/MultiNoiseBiomeSource	PRESET_CODEC	Lcom/mojang/serialization/MapCodec;

